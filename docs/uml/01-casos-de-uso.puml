@startuml
left to right direction
skinparam packageStyle rectangle
actor "Paciente" as Paciente
actor "Administrador" as Administrador

rectangle "Sistema Digital de Citas Médicas" {
  usecase "Crear cuenta" as UC1
  usecase "Iniciar sesión" as UC2
  usecase "Consultar horarios" as UC3
  usecase "Agendar cita" as UC4
  usecase "Consultar mis citas" as UC5
  usecase "Cancelar cita" as UC6
  usecase "Recibir notificaciones" as UC7
  usecase "Administrar horarios" as UC8
  usecase "Gestionar citas" as UC9
  usecase "Gestionar usuarios" as UC10
  usecase "Verificar disponibilidad" as UC11
}
Paciente -- UC1
Paciente -- UC2
Paciente -- UC3
Paciente -- UC4
Paciente -- UC5
Paciente -- UC6
Paciente -- UC7
Administrador -- UC2
Administrador -- UC8
Administrador -- UC9
Administrador -- UC10
UC4 .> UC3 : <<include>>
UC4 .> UC11 : <<include>>
UC6 .> UC11 : <<include>>
@enduml
