classDiagram
direction LR

class Usuario {
  +UUID identificador
  +String nombre
  +String correo
  +String claveCifrada
  +String tipoDeUsuario
  +crearCuenta()
  +iniciarSesion()
}

class Paciente {
  +String telefono
  +consultarCitas()
  +solicitarCita()
  +cancelarCita()
}

class Administrador {
  +crearHorario()
  +actualizarHorario()
  +gestionarCitas()
}

class Cita {
  +UUID identificador
  +Date fecha
  +String hora
  +String estado
  +DateTime fechaDeCreacion
  +confirmar()
  +cancelar()
}

class Horario {
  +UUID identificador
  +Date fecha
  +String horaDeInicio
  +String horaDeFin
  +Boolean disponible
  +verificarDisponibilidad()
}

class Notificacion {
  +UUID identificador
  +String mensaje
  +DateTime fechaDeEnvio
  +String estado
  +enviar()
}

Usuario <|-- Paciente
Usuario <|-- Administrador
Paciente "1" --> "0..*" Cita : solicita
Cita "0..*" --> "1" Horario : reserva
Paciente "1" --> "0..*" Notificacion : recibe
Administrador "1" --> "0..*" Horario : administra
